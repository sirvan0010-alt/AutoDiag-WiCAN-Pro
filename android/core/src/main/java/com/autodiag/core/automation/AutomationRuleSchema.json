{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoDiag Automation Rule",
  "type": "object",
  "required": ["version", "id", "triggerSignalId", "triggerOperator", "triggerThreshold", "conditions", "action", "enabled"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1},
    "triggerSignalId": {"type": "string", "minLength": 1},
    "triggerOperator": {"enum": ["LT", "LTE", "GT", "GTE", "EQ", "NEQ"]},
    "triggerThreshold": {"type": "number"},
    "enabled": {"type": "boolean"},
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signalId", "operator", "threshold"],
        "properties": {
          "signalId": {"type": "string", "minLength": 1},
          "operator": {"enum": ["LT", "LTE", "GT", "GTE", "EQ", "NEQ"]},
          "threshold": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "policy": {"enum": ["READ_LOG_ANALYZE", "NOTIFY_ALERT", "WRITE_COMMAND"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
